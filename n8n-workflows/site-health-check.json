      "parameters": {
        "jsCode": "const siteName = $('Configure Site').first().json.siteName;\nconst response = $input.first().json;\nconst ok = response.status === 'ok';\nreturn [{ json: { siteName, checkedAt: new Date().toISOString(), overallStatus: ok ? 'OK' : 'CHECK_REQUIRED', readOnly: true, result: response, nextStep: ok ? 'No action required. Continue scheduled monitoring.' : 'Review the response and investigate manually. No changes were made.' } }];"
      },
      "id": "2f7b5c41-4444-4b11-9444-444444444444",
